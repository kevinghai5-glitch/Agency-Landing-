# ── Server-only. Never exposed to the client. ──
# Two separate Google Cloud API keys, one per service.
GOOGLE_PAGESPEED_KEY=
GOOGLE_PLACES_KEY=

# ── Public. Swappable without a redeploy. ──
# The embeddable LeadGate qualification form URL. This page embeds it in an
# iframe below a completed scan. Business name + website are appended as query
# params so the form can pre-fill (only if LeadGate reads them — verify).
NEXT_PUBLIC_LEADGATE_EMBED_URL=

# REAL contact inbox (footer + privacy). Unset ships a flagged placeholder.
NEXT_PUBLIC_CONTACT_EMAIL=
